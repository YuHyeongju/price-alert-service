# 이 파일을 복사해서 .env 로 사용하세요.
#   (PowerShell)  Copy-Item .env.example .env
#
# 아래 외부 연동 값들은 전부 "선택"입니다.
# 비워두면 자동으로 mock 모드로 동작하므로, 키 없이도 바로 실행/테스트할 수 있어요.

# --- 보안 (배포 시 반드시 변경) ---
SECRET_KEY=dev-insecure-secret-change-me-before-deploy

# --- 데이터베이스 (기본: SQLite 파일) ---
# PostgreSQL 예시:  postgresql+psycopg://user:pass@localhost:5432/pricewatch
DATABASE_URL=sqlite:///./pricewatch.db

# --- 모니터링 엔진 ---
CHECK_INTERVAL_MINUTES=10
DEFAULT_COOLDOWN_MINUTES=360

# --- 네이버 쇼핑 검색 API (https://developers.naver.com) ---
# 비우면 mock 가격(랜덤 변동)을 사용합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- AI 제공자 (OpenAI 호환) — 비우면: 코멘트는 템플릿, 상품 필터는 건너뜀 ---
#  · OpenAI  : OPENAI_API_KEY=sk-...   (BASE_URL 비움,  MODEL=gpt-4o-mini)
#  · Groq무료: OPENAI_API_KEY=gsk_...  BASE_URL=https://api.groq.com/openai/v1  MODEL=llama-3.3-70b-versatile
#  · Gemini무료: OPENAI_API_KEY=AIza...  BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
USE_AI_FILTER=true

# --- 디스코드 웹훅 (비우면 콘솔에 출력) ---
DISCORD_WEBHOOK_URL=
